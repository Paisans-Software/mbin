{%- set STATUS_PENDING = constant('App\\Entity\\Report::STATUS_PENDING') -%}
<aside class="options options--top options-activity" id="options">
    <div class="options__title">
        <h2>{{ 'magazine_panel'|trans }}</h2>
    </div>
    <menu class="options__main">
        <li>
            <a href="{{ path('magazine_panel_general', {name: magazine.name}) }}"
               class="{{ html_classes({'active': is_route_name('magazine_panel_general')}) }}">
                {{ 'general'|trans }}
            </a>
        </li>
        <li>
            <a href="{{ path('magazine_panel_reports', {name: magazine.name, status: STATUS_PENDING}) }}"
               class="{{ html_classes({'active': is_route_name('magazine_panel_reports')}) }}">
                {{ 'reports'|trans }}
            </a>
        </li>
        <li>
            <a href="{{ path('magazine_panel_moderators', {name: magazine.name}) }}"
               class="{{ html_classes({'active': is_route_name('magazine_panel_moderators')}) }}">
                {{ 'moderators'|trans }}
            </a>
        </li>
        <li>
            <a href="{{ path('magazine_panel_moderator_requests', {name: magazine.name}) }}"
               class="{{ html_classes({'active': is_route_name('magazine_panel_moderator_requests')}) }}">
                {{ 'moderator_requests'|trans }}
            </a>
        </li>
        <li>
            <a href="{{ path('magazine_panel_badges', {name: magazine.name}) }}"
               class="{{ html_classes({'active': is_route_name('magazine_panel_badges')}) }}">
                {{ 'badges'|trans }}
            </a>
        </li>
        <li>
            <a href="{{ path('magazine_panel_tags', {name: magazine.name}) }}"
               class="{{ html_classes({'active': is_route_name('magazine_panel_tags') or is_route_name_contains('_follow')}) }}">
                {{ 'tags_and_follows'|trans }}
            </a>
        </li>
        <li>
            <a href="{{ path('magazine_panel_bans', {name: magazine.name}) }}"
               class="{{ html_classes({'active': is_route_name_contains('_ban')}) }}">
                {{ 'bans'|trans }}
            </a>
        </li>
        {# FORK DIVERGENCE — do not offer this upstream: private magazines #}
        {% if magazine.isRestricted() %}
            <li>
                <a href="{{ path('magazine_panel_members', {name: magazine.name}) }}"
                   class="{{ html_classes({'active': is_route_name_contains('_member')}) }}">
                    {{ 'members'|trans }}
                </a>
            </li>
        {% endif %}
        {# FORK DIVERGENCE — do not offer this upstream: private magazines #}
        {% if magazine.isRestricted() and magazine.access.value is same as 'private' %}
            <li>
                <a href="{{ path('magazine_panel_access_requests', {name: magazine.name}) }}"
                   class="{{ html_classes({'active': is_route_name('magazine_panel_access_requests')}) }}">
                    {{ 'access_requests'|trans }}
                </a>
            </li>
        {% endif %}
        <li>
            <a href="{{ path('magazine_panel_trash', {name: magazine.name}) }}"
               class="{{ html_classes({'active': is_route_name('magazine_panel_trash')}) }}">
                {{ 'trash'|trans }}
            </a>
        </li>
        <li>
            <a href="{{ path('magazine_panel_theme', {name: magazine.name}) }}"
               class="{{ html_classes({'active': is_route_name('magazine_panel_theme')}) }}">
                {{ 'appearance'|trans }}
            </a>
        </li>
        <li>
            <a href="{{ path('magazine_panel_stats', {name: magazine.name}) }}"
               class="{{ html_classes({'active': is_route_name('magazine_panel_stats')}) }}">
                {{ 'stats'|trans }}
            </a>
        </li>
    </menu>
</aside>
