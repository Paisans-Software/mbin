{# FORK DIVERGENCE — do not offer this upstream: private magazines #}
{% extends 'base.html.twig' %}

{%- block title -%}
    {{- 'members'|trans }} - {{ 'magazine_panel'|trans }} - {{ parent() -}}
{%- endblock -%}

{% block mainClass %}page-magazine-panel page-magazine-members{% endblock %}

{% block header_nav %}
{% endblock %}

{% block sidebar_top %}
{% endblock %}

{% block body %}
    {% include 'magazine/panel/_options.html.twig' %}
    {% include 'magazine/_visibility_info.html.twig' %}

    <h1 hidden>{{ 'members'|trans }}</h1>
    {% if members|length %}
        <div id="content" class="section members members-table table-responsive">
            <table>
                <thead>
                <tr>
                    <th>{{ 'name'|trans }}</th>
                    <th>{{ 'created'|trans }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for member in members %}
                    <tr>
                        <td>{{ component('user_inline', {user: member.user, showNewIcon: true}) }}</td>
                        <td>{{ component('date', {date: member.createdAt}) }}</td>
                        <td>
                            <form method="post"
                                  action="{{ path('magazine_panel_member_remove', {name: magazine.name, username: member.user.username}) }}"
                                  data-action="confirmation#ask" data-confirmation-message-param="{{ 'are_you_sure'|trans }}">
                                <input type="hidden" name="token" value="{{ csrf_token('magazine_member_remove') }}">
                                <button class="btn btn__secondary">{{ 'remove_member'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
    {% if(members.haveToPaginate is defined and members.haveToPaginate) %}
        {{ pagerfanta(members, null, {'pageParameter':'[p]'}) }}
    {% endif %}
    {% if not members|length %}
        <aside class="section section--muted">
            <p>{{ 'empty'|trans }}</p>
        </aside>
    {% endif %}
    <section class="section member-add">
        <div class="container">
            <h3 hidden>{{ 'add_member'|trans }}</h3>
            {{ form_start(form) }}
            <div>
                {{ form_label(form.username, 'username') }}
                {{ form_widget(form.username) }}
                {{ form_errors(form.username) }}
            </div>
            <div class="actions">
                {{ form_row(form.submit, { 'label': 'add_member', attr: {class: 'btn btn__primary'} }) }}
            </div>
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
