{% if rich is same as true %}
    {{ component('magazine_inline', {
        magazine: magazine,
        stretchedLink: stretchedLink,
        fullName: fullName,
        showAvatar: showAvatar,
    }) }}
{% else %}
    <a href="{{ path('front_magazine', {name: magazine.name}) }}" title="{{ magazine.name|username(true) }}">
        !{{- magazine.name|username -}}
        {%- if fullName -%}
            @{{- magazine.name|apDomain -}}
        {%- endif -%}
        {# FORK DIVERGENCE — do not offer this upstream: private magazines #}
        {{ include('components/_magazine_access_icon.html.twig', {access: magazine.access.value}, with_context: false) }}
    </a>
{% endif %}
